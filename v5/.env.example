# ews-mcp 4.5 — example configuration.
# Copy to `.env` in the directory you run `ewsmcp` from (auto-loaded),
# or put these in your MCP client's `env` block instead.
# NEVER commit a real .env.

# --- Exchange (required) -------------------------------------------------
EWS_SERVER_URL=https://mail.example.com/EWS/Exchange.asmx
EWS_EMAIL=user@example.com
EWS_USERNAME=user
EWS_PASSWORD=change-me

# --- Safety (defaults shown; already safe) --------------------------------
# read = read-only tools; draft = + drafts/labels; full = + send/delete
EWS_CAPABILITY_TIER=draft
# Global send kill-switch. Nothing sends until this is true AND tier=full.
SEND_ENABLED=false
# Narrow set_oof override. Requires tier=full and two-phase confirmation,
# but does not enable mail sends or meeting responses.
OOF_ENABLED=false
# Narrow respond_to_event override. Requires tier=full and two-phase
# confirmation. NOTE: a meeting response IS mailed to the organizer — this
# switch only separates it from general mail sending, it does not suppress it.
RESPOND_ENABLED=false
# Maximum plain-text characters returned for each OOF reply.
OOF_TEXT_MAX_CHARS=4000
#EWS_RECIPIENT_ALLOWLIST=*@example.com
#EWS_MAX_SENDS_PER_HOUR=10
# Set this to keep confirm tokens valid across restarts:
#SEND_CONFIRM_SECRET=generate-a-long-random-string

# --- Storage: local disk ONLY (cloud-synced folders are refused) ----------
# Default is ~/.ewsmcp. If your home directory is synced (OneDrive etc.),
# point this at a plain local path:
#DATA_DIR=C:\ewsmcp-data

# --- HTTP mode only (all unused over stdio) --------------------------------
#MCP_TRANSPORT=http
#MCP_HOST=127.0.0.1
#MCP_PORT=8000
#MCP_API_KEY=generate-a-long-random-string

# --- Calendar mirror --------------------------------------------------------
# The backfill matters: without it the mirrored window starts at today's
# midnight, so any query reaching one day back misses the mirror and falls
# through to a live CalendarView -- by far the slowest read in the surface.
#EWS_CALENDAR_BACKFILL_DAYS=2
#EWS_CALENDAR_WINDOW_DAYS=14
#EWS_CALENDAR_MAX_ITEMS=200
# A live CalendarView routinely needs 10-30 s; its own deadline keeps
# near-misses from failing against the shared REQUEST_TIMEOUT.
#EWS_CALENDAR_TIMEOUT_SECONDS=90
# The calendar refresh is the most expensive thing this server asks
# Exchange for (45 s measured). It runs on its own clock and yields
# while user calls are waiting.
#EWS_CALENDAR_SYNC_SECONDS=1800

# --- Misc ------------------------------------------------------------------
#EWS_TZ=Asia/Riyadh
#LOG_LEVEL=INFO

# --- Outbound draft attachments -------------------------------------------
# Roots that create_draft/update_draft may read files from, os.pathsep-
# separated (';' on Windows, ':' elsewhere). DATA_DIR is ALWAYS allowed, so
# the get_attachment(mode='save') -> re-attach round trip needs no config.
# Anything outside these roots is refused, including '..' traversal and
# symlinks that resolve out of them.
ATTACH_ALLOWED_DIRS=
ATTACH_MAX_FILES=10
ATTACH_MAX_BYTES=26214400
